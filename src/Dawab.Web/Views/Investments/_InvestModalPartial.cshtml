@model Dawab.Web.ViewModels.InvestModalViewModel

<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in" x-data="{ open: true, hasInsurance: true }" x-show="open" data-price-per-head="@Model.Cycle.StartPricePerHead">
    <div class="bg-white rounded-3xl w-full max-w-lg shadow-2xl max-h-[90dvh] overflow-y-auto border border-gray-100 flex flex-col">
        <!-- Header -->
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50/50 sticky top-0 z-10">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-primary-50 text-primary flex items-center justify-center font-bold">
                    <i data-lucide="wallet" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-lg font-black text-gray-900">خطوات الاستثمار الجديد</h3>
                    <p class="text-[11px] text-gray-400">@Model.Cycle.AnimalType</p>
                </div>
            </div>
            <button @@click="open = false; document.getElementById('modal-container').innerHTML = ''" class="w-9 h-9 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-500 flex items-center justify-center transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <!-- Form Body -->
        <form asp-controller="Investments" asp-action="Submit" method="post" enctype="multipart/form-data" class="p-4 sm:p-6 space-y-5 sm:space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CycleId" value="@Model.Cycle.Id" />

            <!-- Mini Cycle Card -->
            <div class="flex items-center gap-4 bg-primary-50/60 p-3.5 rounded-2xl border border-primary-100">
                <img src="@Model.Cycle.ImageUrl" alt="@Model.Cycle.AnimalType" class="w-16 h-16 rounded-xl object-cover shrink-0">
                <div>
                    <h4 class="font-bold text-gray-900 text-sm">@Model.Cycle.AnimalType</h4>
                    <span class="text-xs text-primary font-bold">المتبقي للتمويل: @Model.Cycle.RemainingFunding.ToString("N0") ج.م</span>
                </div>
            </div>

            <div class="space-y-1.5">
                <label for="heads-count" class="block text-xs font-bold text-gray-700">عدد الرؤوس التي ترغب في استثمارها</label>
                <input type="number" id="heads-count" name="HeadsCount" value="1" min="1" max="@Model.Cycle.AvailableHeads" data-unit-price="@Model.Cycle.StartPricePerHead" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl text-sm font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" required />
                <p class="text-[11px] text-gray-500">السعر للرأس: @Model.Cycle.StartPricePerHead.ToString("N2") ج.م</p>
                <input type="hidden" id="amount-input" name="Amount" value="@Model.Cycle.StartPricePerHead" hx-get="/Investments/CalculateFee" hx-trigger="change" hx-target="#fee-breakdown" hx-include="#insurance-checkbox" />
                <div class="rounded-xl bg-gray-50 px-4 py-3 text-sm">إجمالي الاستثمار: <strong id="investment-total">@Model.Cycle.StartPricePerHead.ToString("N2") ج.م</strong></div>
            </div>

            <!-- Animal Life Insurance Option -->
            <div class="p-4 rounded-2xl border transition-all bg-blue-50/70 border-blue-100 space-y-2">
                <div class="flex items-center justify-between">
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" 
                               id="insurance-checkbox"
                               name="HasAnimalInsurance" 
                               value="true" 
                               checked 
                               hx-get="/Investments/CalculateFee"
                               hx-trigger="change"
                               hx-target="#fee-breakdown"
                               hx-include="#amount-input"
                               class="w-5 h-5 rounded text-primary focus:ring-primary" />
                        <div>
                            <span class="block text-xs font-bold text-blue-900">رسوم تأمين حياة الماشية (3.0%)</span>
                            <span class="block text-[10px] text-gray-500">تخضع التغطية وشروطها لما هو موضح في وثيقة التأمين.</span>
                        </div>
                    </label>
                    <i data-lucide="shield-check" class="w-6 h-6 text-blue-600"></i>
                </div>
            </div>

            <!-- Fee Breakdown Container (Updated live by HTMX) -->
            <div id="fee-breakdown">
                @await Html.PartialAsync("_FeeBreakdownPartial", new Dawab.Application.DTOs.Investments.FeeCalculationDto
                {
                    InvestmentAmount = Model.Amount,
                    PlatformFee = Model.PlatformFee,
                    HasAnimalInsurance = Model.HasAnimalInsurance,
                    AnimalInsuranceFee = Model.AnimalInsuranceFee,
                    TotalAmountToPay = Model.TotalAmountToPay
                })
            </div>

            <!-- Payment Instructions -->
            <div class="p-4 bg-orange-50 border border-orange-100 rounded-2xl text-xs space-y-1.5" role="note">
                <div class="flex items-center gap-1.5 font-bold text-orange-900">
                    <i data-lucide="triangle-alert" class="w-4 h-4 text-orange-600"></i>
                    <span>تنبيه قبل التحويل</span>
                </div>
                <p class="text-orange-800 leading-6">لا تُحوّل أموالاً إلى أي حساب قبل استلام بيانات التحويل المعتمدة مباشرةً من إدارة المنصة. أرفق الإيصال بعد التحويل ليُراجع طلبك.</p>
            </div>

            <!-- Receipt Upload -->
            <div class="space-y-1.5">
                <label class="block text-xs font-bold text-gray-700">إرفاق صورة إيصال التحويل البنكي أو إنستاباي</label>
                <input type="file" name="receiptFile" accept="image/*" class="w-full text-xs text-gray-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 cursor-pointer" required />
            </div>

            <!-- Submit Button -->
            <button type="submit" class="w-full py-4 bg-primary hover:bg-primary-700 text-white font-black rounded-2xl text-sm shadow-xl shadow-primary/20 transition-all flex items-center justify-center gap-2">
                <i data-lucide="check-circle" class="w-4 h-4"></i>
                <span>تأكيد وإرسال طلب الاستثمار</span>
            </button>
        </form>
    </div>
</div>

<script>
    const headsInput = document.getElementById('heads-count');
    const amountInput = document.getElementById('amount-input');
    const investmentTotal = document.getElementById('investment-total');
    if (headsInput instanceof HTMLInputElement && amountInput instanceof HTMLInputElement && investmentTotal) {
        headsInput.addEventListener('input', () => {
            const amount = Math.max(0, Number(headsInput.value) || 0) * Number(headsInput.dataset.unitPrice);
            amountInput.value = amount.toFixed(2);
            investmentTotal.textContent = new Intl.NumberFormat('ar-EG', { minimumFractionDigits: 2 }).format(amount) + ' ج.م';
            amountInput.dispatchEvent(new Event('change', { bubbles: true }));
        });
    }
    lucide.createIcons();
</script>
