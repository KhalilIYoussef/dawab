<!-- Frequently Asked Questions (FAQ) with Alpine.js -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20" x-data="{ activeFaq: null }">
    <div class="text-center space-y-3 mb-12">
        <span class="text-xs font-black text-primary-700 uppercase tracking-wider bg-emerald-50 px-4 py-1.5 rounded-full border border-emerald-200">
            الأسئلة الشائعة
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-gray-900">
            كل ما تود معرفته عن منصة دواب
        </h2>
    </div>

    <div class="space-y-4">
        <!-- FAQ 1 -->
        <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm">
            <button @@click="activeFaq = activeFaq === 1 ? null : 1" 
                    class="w-full p-5 text-right font-black text-gray-900 text-sm sm:text-base flex justify-between items-center hover:bg-gray-50 transition-colors">
                <span>هل الاستثمار عبر منصة دواب متوافق مع الشريعة الإسلامية؟</span>
                <i data-lucide="chevron-down" class="w-5 h-5 text-gray-500 transition-transform duration-300" :class="activeFaq === 1 ? 'rotate-180 text-primary' : ''"></i>
            </button>
            <div x-show="activeFaq === 1" x-collapse class="p-5 pt-0 text-xs sm:text-sm text-gray-700 leading-relaxed border-t border-gray-100">
                نعم، بنسبة 100%. الاستثمار قائم على عقد "المضاربة والمشاركة المشروعة" في تجارة وإنتاج فعلي (شراء الماشية، تسمينها، وبيعها في السوق). الأرباح مقسمة بنسب معلومة من صافي الربح الفعلي بعد البيع (60% للمستثمرين، 30% للمربي، 10% للمنصة)، ولا توجد أي فائدة ربوية ثابتة أو مضمونة مسبقاً.
            </div>
        </div>

        <!-- FAQ 2 -->
        <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm">
            <button @@click="activeFaq = activeFaq === 2 ? null : 2" 
                    class="w-full p-5 text-right font-black text-gray-900 text-sm sm:text-base flex justify-between items-center hover:bg-gray-50 transition-colors">
                <span>ما هي الضمانات التي تحمي رأس مالي؟</span>
                <i data-lucide="chevron-down" class="w-5 h-5 text-gray-500 transition-transform duration-300" :class="activeFaq === 2 ? 'rotate-180 text-primary' : ''"></i>
            </button>
            <div x-show="activeFaq === 2" x-collapse class="p-5 pt-0 text-xs sm:text-sm text-gray-700 leading-relaxed border-t border-gray-100">
                نوفر 4 ضمانات رئيسية: 1) عقد استثمار رسمي مدني ملزم يحمل أرقام تعريفية للرؤوس المستثمر بها. 2) وثيقة تأمين حياة الماشية ضد النفوق والأوبئة (3%). 3) تأمين الحظيرة المعتمد ضد الحوادث. 4) التحقق الجنائي والقانوني وتوثيق الضمانات على المربي قبل تسليمه أي دورة.
            </div>
        </div>

        <!-- FAQ 3 -->
        <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm">
            <button @@click="activeFaq = activeFaq === 3 ? null : 3" 
                    class="w-full p-5 text-right font-black text-gray-900 text-sm sm:text-base flex justify-between items-center hover:bg-gray-50 transition-colors">
                <span>كيف يمكنني متابعة أوزان وصحة الماشية أثناء الدورة؟</span>
                <i data-lucide="chevron-down" class="w-5 h-5 text-gray-500 transition-transform duration-300" :class="activeFaq === 3 ? 'rotate-180 text-primary' : ''"></i>
            </button>
            <div x-show="activeFaq === 3" x-collapse class="p-5 pt-0 text-xs sm:text-sm text-gray-700 leading-relaxed border-t border-gray-100">
                من خلال لوحة تحكم المستثمر على المنصة، يسجل المربي والطبيب البيطري سجلات دورية مصورة تشمل قياسات الوزن الفعلي ومعدل التحويل الغذائي اليومي، مع جدول التطعيمات البيطرية ونوع الأعلاف المستهلكة.
            </div>
        </div>

        <!-- FAQ 4 -->
        <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm">
            <button @@click="activeFaq = activeFaq === 4 ? null : 4" 
                    class="w-full p-5 text-right font-black text-gray-900 text-sm sm:text-base flex justify-between items-center hover:bg-gray-50 transition-colors">
                <span>متى وكيف يتم تحويل رأس المال والأرباح إلى حسابي؟</span>
                <i data-lucide="chevron-down" class="w-5 h-5 text-gray-500 transition-transform duration-300" :class="activeFaq === 4 ? 'rotate-180 text-primary' : ''"></i>
            </button>
            <div x-show="activeFaq === 4" x-collapse class="p-5 pt-0 text-xs sm:text-sm text-gray-700 leading-relaxed border-t border-gray-100">
                عند اكتمال مدة دورة التسمين (عادة 4 إلى 6 أشهر) وبيع الماشية، تقوم إدارة المنصة بتسوية الحسابات وحساب صافي الأرباح وإيداع كامل رأس المال بالإضافة للأرباح في حسابك البنكي أو محفظتك أو إنستاباي خلال 72 ساعة عمل.
            </div>
        </div>
    </div>
</section>

<!-- Final Bottom CTA Banner with Guaranteed Solid Dark Green Gradient -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="relative overflow-hidden rounded-[2.5rem] cta-gradient-bg px-8 py-16 sm:px-14 sm:py-20 text-center text-white shadow-2xl border border-emerald-900/60">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-emerald-500/15 blur-3xl"></div>
