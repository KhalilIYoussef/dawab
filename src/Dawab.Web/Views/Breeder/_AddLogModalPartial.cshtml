@model Dawab.Web.ViewModels.AddDailyLogViewModel

<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in" x-data="{ open: true }" x-show="open">
    <div class="bg-white rounded-3xl w-full max-w-lg shadow-2xl max-h-[90vh] overflow-y-auto border border-gray-100 flex flex-col">
        <!-- Header -->
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50/50 sticky top-0 z-10">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-secondary-50 text-secondary flex items-center justify-center font-bold">
                    <i data-lucide="edit-3" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-lg font-black text-gray-900">تسجيل التقرير اليومي للإنتاج</h3>
                    <p class="text-[11px] text-gray-400">تحديث كميات العلف، الأوزان، والرعاية البيطرية</p>
                </div>
            </div>
            <button @@click="open = false; document.getElementById('modal-container').innerHTML = ''" class="w-9 h-9 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-500 flex items-center justify-center transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <form asp-controller="Breeder" asp-action="SubmitLog" method="post" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CycleId" value="@Model.CycleId" />

            <!-- Weight -->
            <div class="space-y-1">
                <label class="block text-xs font-bold text-gray-700">الوزن الحالي للرأس (كجم) - اختياري</label>
                <input type="number" step="0.5" name="CurrentWeight" value="@Model.CurrentWeight" placeholder="مثال: 265" class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <!-- Feed Concentrate -->
                <div class="space-y-1">
                    <label class="block text-xs font-bold text-gray-700">علف مركز (كجم/رأس)</label>
                    <input type="number" step="0.25" name="FeedConcentrateKg" value="@Model.FeedConcentrateKg" class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" required />
                </div>

                <!-- Roughage -->
                <div class="space-y-1">
                    <label class="block text-xs font-bold text-gray-700">مواد خشنة (كجم/رأس)</label>
                    <input type="number" step="0.5" name="RoughageKg" value="@Model.RoughageKg" class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" required />
                </div>
            </div>

            <!-- Vet Actions -->
            <div class="space-y-1">
                <label class="block text-xs font-bold text-gray-700">تحصين وقائي تم إعطاؤه اليوم (إن وجد)</label>
                <input type="text" name="VaccineApplied" placeholder="مثال: تحصين الحمى القلاعية (FMD)" class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" />
            </div>

            <div class="space-y-1">
                <label class="block text-xs font-bold text-gray-700">علاج طارئ أو مكمل غذائي (إن وجد)</label>
                <input type="text" name="TreatmentApplied" placeholder="مثال: فيتامين AD3E في مياه الشرب" class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" />
            </div>

            <!-- General Notes -->
            <div class="space-y-1">
                <label class="block text-xs font-bold text-gray-700">ملاحظات عامة</label>
                <textarea name="GeneralNotes" rows="2" placeholder="ملاحظات حول صحة القطيع ومعدل الشهية..." class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary"></textarea>
            </div>

            <!-- Submit -->
            <button type="submit" class="w-full py-3.5 bg-secondary hover:bg-secondary-700 text-white font-bold rounded-2xl text-sm shadow-lg shadow-secondary/20 transition-all flex items-center justify-center gap-2 mt-2">
                <i data-lucide="check" class="w-4 h-4"></i>
                <span>حفظ التقرير اليومي وتحديث التايم لاين</span>
            </button>
        </form>
    </div>
</div>

<script>
    lucide.createIcons();
</script>
