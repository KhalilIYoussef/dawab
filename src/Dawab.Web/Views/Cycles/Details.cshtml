@model Dawab.Web.ViewModels.CycleDetailsViewModel
@{
    ViewData["Title"] = Model.Cycle.AnimalType + " - تفاصيل الدورة";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <!-- Breadcrumb & Back -->
    <div class="flex items-center gap-2 text-xs font-bold text-gray-500">
        <a asp-action="Index" class="hover:text-primary transition-colors">الدورات المتاحة</a>
        <i data-lucide="chevron-left" class="w-3.5 h-3.5"></i>
        <span class="text-gray-900">@Model.Cycle.AnimalType</span>
    </div>

    <!-- Cycle Hero & Specs -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm">
        <div class="lg:col-span-6 rounded-2xl overflow-hidden relative h-80 sm:h-96">
            <img src="@Model.Cycle.ImageUrl" alt="@Model.Cycle.AnimalType" class="w-full h-full object-cover">
            @if (Model.Cycle.IsBarnInsured)
            {
                <div class="absolute top-4 right-4 bg-orange-600 text-white px-3 py-1.5 rounded-xl text-xs font-black shadow-lg flex items-center gap-1.5">
                    <i data-lucide="shield" class="w-4 h-4"></i>
                    <span>خيار تأمين الحظيرة مسجل</span>
                </div>
            }
        </div>

        <div class="lg:col-span-6 flex flex-col justify-between space-y-6">
            <div class="space-y-3">
                <div class="flex justify-between items-start">
                    <h1 class="text-3xl font-black text-gray-900">@Model.Cycle.AnimalType</h1>
                    <span class="px-3 py-1 rounded-full text-xs font-black @(Model.Cycle.Status == CycleStatus.Active ? "bg-green-100 text-green-800" : Model.Cycle.Status == CycleStatus.Funding ? "bg-blue-100 text-blue-800" : "bg-yellow-100 text-yellow-800")">
                        @(Model.Cycle.Status == CycleStatus.Active ? "نشطة (قيد التسمين)" : Model.Cycle.Status == CycleStatus.Funding ? "مفتوحة للتمويل" : Model.Cycle.Status == CycleStatus.Pending ? "بانتظار اعتماد الدورة" : Model.Cycle.Status == CycleStatus.Completed ? "مكتملة" : Model.Cycle.Status == CycleStatus.Rejected ? "مرفوضة" : "ملغاة")
                    </span>
                </div>

                <p class="text-xs text-gray-500 font-medium">المربي: <span class="text-gray-800 font-bold">@Model.Cycle.BreederName</span> | المحافظة: @Model.Cycle.BreederGovernorate</p>
                <p class="text-sm text-gray-600 leading-relaxed">@Model.Cycle.Description</p>
            </div>

            <!-- Key Metric Cards -->
            <div class="grid grid-cols-3 gap-3 bg-gray-50 p-4 rounded-2xl border border-gray-100 text-center">
                <div>
                    <span class="block text-[11px] text-gray-400 font-bold">الوزن الحالي</span>
                    <span class="text-lg font-black text-gray-900">@Model.Cycle.InitialWeight كجم</span>
                </div>
                <div class="border-x border-gray-200">
                    <span class="block text-[11px] text-gray-400 font-bold">الوزن المستهدف</span>
                    <span class="text-lg font-black text-primary">@Model.Cycle.TargetWeight كجم</span>
                </div>
                <div>
                    <span class="block text-[11px] text-gray-400 font-bold">مدة التسمين</span>
                    <span class="text-lg font-black text-gray-900">@Model.Cycle.ExpectedDurationDays يوم</span>
                </div>
            </div>

            <!-- Funding Progress -->
            <div class="space-y-2">
                <div class="flex justify-between text-xs font-bold">
                    <span class="text-gray-500">التمويل المحقق (@Model.Cycle.FundingProgressPercentage%)</span>
                    <span class="text-primary font-black">@Model.Cycle.CurrentFunding.ToString("N0") / @Model.Cycle.FundingGoal.ToString("N0") ج.م</span>
                </div>
                <div class="w-full bg-gray-100 h-3 rounded-full overflow-hidden">
                    <div class="bg-primary h-full rounded-full transition-all duration-700" style="width: @Model.Cycle.FundingProgressPercentage%"></div>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
                @if (Model.Cycle.Status == CycleStatus.Funding && Model.Cycle.RemainingFunding > 0)
                {
                    @if (Context.Session.GetString("UserRole") == "Investor")
                    {
                        <button hx-get="/Investments/InvestModal?cycleId=@Model.Cycle.Id" 
                                hx-target="#modal-container" 
                                hx-swap="innerHTML"
                                class="flex-1 bg-primary hover:bg-primary-700 text-white font-black py-4 rounded-2xl text-center text-sm shadow-xl shadow-primary/20 transition-all flex items-center justify-center gap-2">
                            <i data-lucide="wallet" class="w-4 h-4"></i>
                            <span>استثمر في هذه الدورة الآن</span>
                        </button>
                    }
                    else if (Context.Session.GetString("UserId") == null)
                    {
                        <a asp-controller="Auth" asp-action="Login" class="flex-1 bg-primary hover:bg-primary-700 text-white font-black py-4 rounded-2xl text-center text-sm shadow-xl shadow-primary/20 transition-all">سجل الدخول للاستثمار</a>
                    }
                }

                <button hx-get="/Cycles/RiskAnalysis?id=@Model.Cycle.Id"
                        hx-target="#modal-container" 
                        hx-swap="innerHTML"
                        class="px-5 py-4 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold rounded-2xl text-sm transition-all flex items-center gap-2">
                    <i data-lucide="brain-circuit" class="w-4 h-4 text-primary"></i>
                    <span>تقرير الذكاء الاصطناعي</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Fattening Feeding & Veterinary Care Plan -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Feeding Stages -->
        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm space-y-6">
            <div class="flex items-center gap-3 border-b border-gray-100 pb-4">
                <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center text-primary font-black">
                    <i data-lucide="wheat" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="font-black text-gray-900 text-lg">خطة التغذية المسجلة</h3>
                    <p class="text-xs text-gray-400">مراحل التغذية اليومية المسجلة للدورة</p>
                </div>
            </div>

            <div class="space-y-4">
                @foreach (var stage in Model.Cycle.Stages)
                {
                    <div class="bg-gray-50 p-4 rounded-2xl border border-gray-100 space-y-2">
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-primary-800 text-sm">@stage.StageName</span>
                            <span class="text-[11px] font-bold text-gray-400">المرحلة @stage.StageOrder</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-xs">
                            <div class="bg-white p-2.5 rounded-xl border border-gray-200/60">
                                <span class="text-gray-400 block text-[10px]">علف مركز</span>
                                <span class="font-bold text-gray-800">@stage.FeedConcentrateKg كجم / يوم</span>
                            </div>
                            <div class="bg-white p-2.5 rounded-xl border border-gray-200/60">
                                <span class="text-gray-400 block text-[10px]">مواد خشنة (سيلاج/تبن)</span>
                                <span class="font-bold text-gray-800">@stage.RoughageKg كجم / يوم</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Veterinary Plan -->
        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm space-y-6">
            <div class="flex items-center gap-3 border-b border-gray-100 pb-4">
                <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600 font-black">
                    <i data-lucide="stethoscope" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="font-black text-gray-900 text-lg">التحصينات المسجلة للدورة</h3>
                    <p class="text-xs text-gray-400">راجع تفاصيل الرعاية البيطرية ومستنداتها مع المربي</p>
                </div>
            </div>

            <div class="space-y-3">
                @foreach (var vaccine in Model.Cycle.MandatoryVaccines)
                {
                    <div class="p-3.5 bg-blue-50/50 rounded-2xl border border-blue-100 flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <i data-lucide="syringe" class="w-4 h-4 text-blue-600"></i>
                            <span class="text-sm font-bold text-blue-900">@vaccine</span>
                        </div>
                        <span class="text-[10px] font-bold bg-white text-blue-700 px-2.5 py-1 rounded-lg border border-blue-200 shadow-sm">ضمن بيانات الدورة</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Production Daily Monitoring Timeline -->
    <div class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm space-y-6">
        <div class="flex items-center justify-between border-b border-gray-100 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center text-secondary font-black">
                    <i data-lucide="activity" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="font-black text-gray-900 text-lg">سجل المتابعة اليومية للإنتاج</h3>
                    <p class="text-xs text-gray-400">تقارير التغذية، تطور الوزن، والتحصينات من المربي</p>
                </div>
            </div>
        </div>

        <div class="space-y-4">
            @foreach (var log in Model.Logs)
            {
                <article class="bg-gray-50 p-4 sm:p-5 rounded-2xl border border-gray-100 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2 border-b border-gray-200/60 pb-3">
                        <div class="flex items-center gap-2">
                            <i data-lucide="calendar" class="w-4 h-4 text-gray-400"></i>
                            <span class="text-xs font-bold text-gray-800">@log.LogDate.ToString("dddd، dd MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("ar-EG"))</span>
                        </div>
                        @if (log.CurrentWeight.HasValue)
                        {
                            <span class="self-start sm:self-auto bg-white px-2.5 py-1 rounded-lg text-xs font-black text-primary border border-gray-200 shadow-sm">
                                الوزن المسجل: @log.CurrentWeight كجم
                            </span>
                        }
                    </div>

                    @if (log.FeedItems.Any())
                    {
                        <div class="space-y-2">
                            <h4 class="text-[11px] font-black text-gray-600 flex items-center gap-1.5">
                                <i data-lucide="wheat" class="w-3.5 h-3.5 text-primary"></i>
                                سجل التغذية اليومي
                            </h4>
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
                                @foreach (var feed in log.FeedItems)
                                {
                                    var feedColor = feed.Category == Dawab.Domain.Enums.FeedCategory.Energy
                                        ? "bg-orange-50 border-orange-100 text-orange-800"
                                        : feed.Category == Dawab.Domain.Enums.FeedCategory.Roughage
                                            ? "bg-green-50 border-green-100 text-green-800"
                                            : "bg-blue-50 border-blue-100 text-blue-800";
                                    <div class="p-3 rounded-xl border @feedColor">
                                        <p class="text-xs font-bold break-words">@feed.ItemName</p>
                                        <p class="text-[11px] mt-1">@feed.Quantity.ToString("N2") @feed.Unit</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(log.FoodSummary))
                    {
                        <p class="text-xs text-gray-700 font-medium leading-relaxed">
                            <span class="font-bold text-gray-900">تفاصيل التغذية:</span> @log.FoodSummary
                        </p>
                    }

                    @if (log.WaterLiters.HasValue)
                    {
                        <p class="text-xs text-blue-800 bg-blue-50 p-3 rounded-xl border border-blue-100">المياه: @log.WaterLiters لتر</p>
                    }

                    @if (log.VetRecords.Any())
                    {
                        <div class="space-y-2">
                            <h4 class="text-[11px] font-black text-gray-600 flex items-center gap-1.5">
                                <i data-lucide="heart-pulse" class="w-3.5 h-3.5 text-red-500"></i>
                                الحالة الطبية
                            </h4>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                @foreach (var record in log.VetRecords)
                                {
                                    var isVaccine = record.RecordType == Dawab.Domain.Enums.VetRecordType.Vaccine;
                                    <div class="p-3 rounded-xl border @(isVaccine ? "bg-blue-50 border-blue-100" : "bg-red-50 border-red-100")">
                                        <p class="text-xs font-bold @(isVaccine ? "text-blue-800" : "text-red-800")">@(isVaccine ? "تحصين" : "علاج"): @record.Title</p>
                                        @if (!string.IsNullOrWhiteSpace(record.Dosage))
                                        {
                                            <p class="text-[11px] text-gray-600 mt-1">الجرعة: @record.Dosage</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(record.Notes))
                                        {
                                            <p class="text-[11px] text-gray-600 mt-1">@record.Notes</p>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (log.ImageUrls.Any())
                    {
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
                            @foreach (var imageUrl in log.ImageUrls)
                            {
                                <a href="@imageUrl" target="_blank" rel="noopener noreferrer" class="block aspect-square rounded-xl overflow-hidden bg-gray-100">
                                    <img src="@imageUrl" alt="صورة من تقرير @log.LogDate.ToString("yyyy-MM-dd")" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition-transform" />
                                </a>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(log.Notes))
                    {
                        <p class="text-xs text-gray-600 bg-white p-3 rounded-xl border border-gray-100 break-words">
                            <span class="font-bold text-gray-900">ملاحظات المربي:</span> @log.Notes
                        </p>
                    }
                </article>
            }

            @if (!Model.Logs.Any())
            {
                <div class="text-center py-12 text-gray-400 text-xs font-medium">
                    <i data-lucide="clock" class="w-8 h-8 text-gray-300 mx-auto mb-2"></i>
                    بانتظار تسجيل التقرير اليومي الأول من المربي بعد استلام الماشية
                </div>
            }
        </div>
    </div>
</div>
