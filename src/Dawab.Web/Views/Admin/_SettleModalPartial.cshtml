@model Dawab.Web.ViewModels.SettleCycleViewModel

<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in" x-data="{ open: true }" x-show="open">
    <div class="bg-white rounded-3xl w-full max-w-lg shadow-2xl max-h-[90vh] overflow-y-auto border border-gray-100 flex flex-col">
        <!-- Header -->
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50/50 sticky top-0 z-10">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-green-50 text-primary flex items-center justify-center font-bold">
                    <i data-lucide="coins" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-lg font-black text-gray-900">تسوية وإغلاق الدورة الإنتاجية</h3>
                    <p class="text-[11px] text-gray-400">@Model.AnimalType</p>
                </div>
            </div>
            <button @@click="open = false; document.getElementById('modal-container').innerHTML = ''" class="w-9 h-9 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-500 flex items-center justify-center transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <form asp-controller="Admin" asp-action="SettleCycle" method="post" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CycleId" value="@Model.CycleId" />

            <div class="bg-gray-50 p-4 rounded-2xl border border-gray-100 space-y-2 text-xs">
                <div class="flex justify-between text-gray-600">
                    <span>رأس المال الممول للدورة:</span>
                    <span class="font-bold text-gray-900">@Model.FundingGoal.ToString("N0") ج.م</span>
                </div>
                <div class="flex justify-between text-gray-600">
                    <span>عمولة المنصة من الربح الإجمالي:</span>
                    <span class="font-bold text-primary">10%</span>
                </div>
                <div class="flex justify-between text-gray-600">
                    <span>حصة المربي من الربح المتبقي بعد العمولة:</span>
                    <span class="font-bold text-secondary">30%</span>
                </div>
                <div class="flex justify-between text-gray-600">
                    <span>حصة المستثمرين من الربح المتبقي بعد العمولة وحصة المربي:</span>
                    <span class="font-bold text-blue-700">70%</span>
                </div>
            </div>

            <div class="space-y-1">
                <label class="block text-xs font-bold text-gray-700">سعر البيع النهائي الفعلي (ج.م)</label>
                <input type="number" name="FinalSalePrice" value="@Model.FinalSalePrice" min="0.01" step="0.01" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl text-base font-black text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" required />
                <p class="text-[11px] text-gray-500">أدخل حصيلة البيع الفعلية لكل رؤوس الدورة. عند وجود خسارة، يُوزّع رأس المال المتاح تناسبياً ولا تُضمن استعادته بالكامل.</p>
            </div>

            <div class="space-y-1">
                <label class="block text-xs font-bold text-gray-700">ملاحظات التسوية النهائية</label>
                <textarea name="Notes" rows="2" class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-xs font-medium text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" placeholder="أي تفاصيل تخص عملية بيع الماشية..."></textarea>
            </div>

            <button type="submit" class="w-full py-4 bg-primary hover:bg-primary-700 text-white font-black rounded-2xl text-sm shadow-xl shadow-primary/20 transition-all flex items-center justify-center gap-2 mt-2">
                <i data-lucide="check-check" class="w-4 h-4"></i>
                <span>تأكيد البيع واحتساب وتوزيع الأرباح</span>
            </button>
        </form>
    </div>
</div>

<script>
    lucide.createIcons();
</script>
