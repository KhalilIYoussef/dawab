@model Dawab.Application.DTOs.Dashboard.HomeDashboardDto
@{
    ViewData["Title"] = "دواب | نربط الاستثمار بالإنتاج الحيواني";
}

@{
    var featuredCycle = Model.FeaturedCycles.FirstOrDefault();
}

<!-- Welcome / Splash Hero -->
<section class="relative isolate overflow-hidden bg-primary-900 text-white">
    <div class="absolute inset-0 -z-10">
        <img src="https://images.unsplash.com/photo-1500595046743-cd271d694d30?auto=format&fit=crop&w=1800&q=85" alt="مزرعة في الريف" class="w-full h-full object-cover opacity-20" />
        <div class="absolute inset-0 bg-gradient-to-l from-primary-900 via-primary-900/90 to-primary-900/50"></div>
        <div class="absolute -bottom-36 -left-24 w-96 h-96 rounded-full bg-green-500/10 blur-3xl"></div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 lg:py-24">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
            <div class="lg:col-span-7 text-center lg:text-right">
                <span class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full bg-white/10 text-green-100 text-xs font-bold border border-white/15 backdrop-blur">
                    <i data-lucide="sprout" class="w-4 h-4"></i>
                    منصة دواب للإنتاج الحيواني
                </span>
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight mt-6">
                    استثمار أقرب إلى <span class="text-yellow-300">الإنتاج الحقيقي</span>
                </h1>
                <p class="text-base sm:text-lg text-white/75 leading-8 max-w-2xl mx-auto lg:mx-0 mt-5">
                    دواب تنظم التعاون بين المستثمر والمربي في دورات تسمين واضحة الخطوات؛ من عرض بيانات الدورة ومراجعتها، إلى متابعة سجلاتها وتسويتها.
                </p>
                <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start mt-8">
                    @if (Context.Session.GetString("UserRole") == "Breeder")
                    {
                        <a asp-controller="Breeder" asp-action="CreateCycle" class="inline-flex items-center justify-center gap-2 bg-white text-primary-900 hover:bg-green-50 font-black px-7 py-3.5 rounded-2xl transition-colors">
                            <i data-lucide="plus" class="w-5 h-5"></i>
                            أنشئ دورة إنتاج
                        </a>
                    }
                    else if (Context.Session.GetString("UserRole") == "Investor")
                    {
                        <a asp-controller="Cycles" asp-action="Index" class="inline-flex items-center justify-center gap-2 bg-white text-primary-900 hover:bg-green-50 font-black px-7 py-3.5 rounded-2xl transition-colors">
                            استكشف الدورات المتاحة
                            <i data-lucide="arrow-left" class="w-4 h-4"></i>
                        </a>
                    }
                    else if (Context.Session.GetString("UserId") == null)
                    {
                        <a asp-controller="Home" asp-action="Onboarding" class="inline-flex items-center justify-center gap-2 bg-white text-primary-900 hover:bg-green-50 font-black px-7 py-3.5 rounded-2xl transition-colors">
                            ابدأ رحلتك مع دواب
                            <i data-lucide="arrow-left" class="w-4 h-4"></i>
                        </a>
                        <a asp-controller="Cycles" asp-action="Index" class="inline-flex items-center justify-center gap-2 border border-white/30 hover:bg-white/10 text-white font-bold px-7 py-3.5 rounded-2xl transition-colors">تصفح الدورات</a>
                    }
                    else
                    {
                        <a asp-controller="Admin" asp-action="Dashboard" class="inline-flex items-center justify-center gap-2 bg-white text-primary-900 hover:bg-green-50 font-black px-7 py-3.5 rounded-2xl transition-colors">لوحة الإدارة</a>
                    }
                    <a href="#vision" class="inline-flex items-center justify-center gap-2 border border-white/30 hover:bg-white/10 text-white font-bold px-7 py-3.5 rounded-2xl transition-colors">
                        اكتشف رؤيتنا
                        <i data-lucide="arrow-down" class="w-4 h-4"></i>
                    </a>
                </div>
                <div class="flex flex-wrap justify-center lg:justify-start gap-x-6 gap-y-3 mt-8 text-xs sm:text-sm text-white/70">
                    <span class="inline-flex items-center gap-2"><i data-lucide="clipboard-check" class="w-4 h-4 text-green-300"></i>معلومات منظمة للدورة</span>
                    <span class="inline-flex items-center gap-2"><i data-lucide="activity" class="w-4 h-4 text-green-300"></i>سجلات لمتابعة التقدم</span>
                    <span class="inline-flex items-center gap-2"><i data-lucide="users-round" class="w-4 h-4 text-green-300"></i>مساحة مشتركة للمستثمر والمربي</span>
                </div>
                @if (Context.Session.GetString("UserId") == null)
                {
                    <a asp-controller="Home" asp-action="Splash" class="inline-flex items-center gap-2 text-sm font-bold text-green-200 hover:text-white mt-6 transition-colors">
                        <i data-lucide="play-circle" class="w-4 h-4"></i>
                        شاهد مقدمة دواب
                    </a>
                }
            </div>

            <div class="lg:col-span-5 max-w-lg mx-auto w-full">
                <div class="relative bg-white/10 rounded-[2rem] p-3 border border-white/15 shadow-2xl backdrop-blur-sm">
                    @if (featuredCycle != null)
                    {
                        <a asp-controller="Cycles" asp-action="Details" asp-route-id="@featuredCycle.Id" class="block group">
                            <div class="relative h-64 sm:h-72 rounded-[1.4rem] overflow-hidden">
                                <img src="@(string.IsNullOrWhiteSpace(featuredCycle.ImageUrl) ? "https://images.unsplash.com/photo-1500595046743-cd271d694d30?auto=format&fit=crop&w=900&q=80" : featuredCycle.ImageUrl)" alt="@featuredCycle.AnimalType" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                <span class="absolute top-4 right-4 bg-white/95 text-primary-900 px-3 py-1.5 rounded-full text-xs font-black">من الدورات المتاحة</span>
                            </div>
                            <div class="px-3 pt-4 pb-2">
                                <div class="flex items-start justify-between gap-3">
                                    <h2 class="font-black text-white text-lg">@featuredCycle.AnimalType</h2>
                                    <span class="text-xs text-green-100 shrink-0">@featuredCycle.RemainingFunding.ToString("N0") ج.م متبقية</span>
                                </div>
                                <p class="text-xs text-white/65 mt-2 line-clamp-2">@featuredCycle.Description</p>
                                <div class="w-full bg-white/20 h-2 rounded-full overflow-hidden mt-4">
                                    <div class="bg-yellow-300 h-full rounded-full" style="width: @featuredCycle.FundingProgressPercentage%"></div>
                                </div>
                                <div class="flex justify-between text-[11px] text-white/70 mt-2"><span>التقدم في التمويل</span><span>@featuredCycle.FundingProgressPercentage%</span></div>
                            </div>
                        </a>
                    }
                    else
                    {
                        <div class="relative h-64 sm:h-72 rounded-[1.4rem] overflow-hidden">
                            <img src="https://images.unsplash.com/photo-1500595046743-cd271d694d30?auto=format&fit=crop&w=900&q=80" alt="مزرعة في الريف" class="w-full h-full object-cover" />
                            <div class="absolute inset-0 bg-gradient-to-t from-primary-900/90 via-primary-900/10 to-transparent"></div>
                            <div class="absolute bottom-5 right-5 left-5">
                                <span class="text-xs font-bold text-green-200">الفكرة ببساطة</span>
                                <p class="text-xl font-black mt-1">دورة واضحة. متابعة مستمرة. تعاون منظم.</p>
                            </div>
                        </div>
                        <p class="text-xs leading-6 text-white/65 px-3 py-3">لا توجد دورات متاحة للعرض حالياً. تعرّف على طريقة عمل المنصة وكن أول من يستكشف الفرص عند إتاحتها.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Platform Snapshot -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-7 sm:-mt-10 relative z-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3 sm:gap-4">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-green-50 flex items-center justify-center text-primary-700">
                <i data-lucide="layers" class="w-7 h-7"></i>
            </div>
            <div>
                <p class="text-xs text-gray-500 font-medium">إجمالي الدورات</p>
                <p class="text-2xl font-black text-gray-900">@Model.TotalCyclesCount دورة</p>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-orange-50 flex items-center justify-center text-secondary">
                <i data-lucide="tractor" class="w-7 h-7"></i>
            </div>
            <div>
                <p class="text-xs text-gray-500 font-medium">المربون النشطون</p>
                <p class="text-2xl font-black text-gray-900">@Model.ActiveBreederCount مزارع</p>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600">
                <i data-lucide="banknote" class="w-7 h-7"></i>
            </div>
            <div>
                <p class="text-xs text-gray-500 font-medium">الاستثمارات المنفذة</p>
                <p class="text-2xl font-black text-gray-900">@Model.TotalInvestedAmount.ToString("N0") ج.م</p>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-yellow-50 flex items-center justify-center text-yellow-600">
                <i data-lucide="shield-check" class="w-7 h-7"></i>
            </div>
            <div>
                <p class="text-xs text-gray-500 font-medium">رصيد صندوق التأمين</p>
                <p class="text-2xl font-black text-gray-900">@Model.InsuranceSummary.TotalFundBalance.ToString("N0") ج.م</p>
            </div>
        </div>
    </div>
</section>

<!-- Vision and How Dawab Works -->
<section id="vision" class="bg-white border-y border-gray-100 mt-16 sm:mt-20 scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
        <div class="max-w-3xl mx-auto text-center">
            <span class="text-xs font-black text-primary">رؤيتنا</span>
            <h2 class="text-3xl sm:text-4xl font-black text-gray-900 mt-3">سلسلة إنتاج أكثر وضوحاً وترابطاً</h2>
            <p class="text-sm sm:text-base text-gray-600 leading-8 mt-4">نؤمن أن تطوير الإنتاج الحيواني يحتاج إلى تعاون عملي بين من يملك رأس المال ومن يمتلك الخبرة والمزرعة. تعمل دواب على تنظيم هذا التعاون رقمياً، وتوثيق خطوات الدورة ومعلوماتها بما يساعد أطرافها على المتابعة واتخاذ قرارات أوضح.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-10">
            <article class="rounded-2xl bg-gray-50 border border-gray-100 p-5">
                <div class="w-11 h-11 rounded-xl bg-green-100 text-primary flex items-center justify-center"><i data-lucide="file-search" class="w-5 h-5"></i></div>
                <h3 class="font-black text-gray-900 mt-4">١. بيانات ومراجعة</h3>
                <p class="text-xs leading-6 text-gray-600 mt-2">تُعرض بيانات الدورة وتخضع للمراجعة قبل إتاحتها، حتى يعرف المشاركون تفاصيلها الأساسية.</p>
            </article>
            <article class="rounded-2xl bg-gray-50 border border-gray-100 p-5">
                <div class="w-11 h-11 rounded-xl bg-orange-100 text-secondary flex items-center justify-center"><i data-lucide="handshake" class="w-5 h-5"></i></div>
                <h3 class="font-black text-gray-900 mt-4">٢. مشاركة منظمة</h3>
                <p class="text-xs leading-6 text-gray-600 mt-2">تربط المنصة المستثمر بالدورة، وتدير طلب الاستثمار والمستندات المرتبطة به.</p>
            </article>
            <article class="rounded-2xl bg-gray-50 border border-gray-100 p-5">
                <div class="w-11 h-11 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center"><i data-lucide="clipboard-list" class="w-5 h-5"></i></div>
                <h3 class="font-black text-gray-900 mt-4">٣. متابعة موثقة</h3>
                <p class="text-xs leading-6 text-gray-600 mt-2">يسجل المربي تحديثات الدورة، مثل الأوزان والتغذية والرعاية البيطرية، لتكون متاحة للمتابعة.</p>
            </article>
            <article class="rounded-2xl bg-gray-50 border border-gray-100 p-5">
                <div class="w-11 h-11 rounded-xl bg-yellow-100 text-yellow-700 flex items-center justify-center"><i data-lucide="receipt-text" class="w-5 h-5"></i></div>
                <h3 class="font-black text-gray-900 mt-4">٤. إغلاق وتسوية</h3>
                <p class="text-xs leading-6 text-gray-600 mt-2">عند إتمام الدورة، تُدار بيانات التسوية والتوزيعات عبر إجراءات المنصة.</p>
            </article>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-10">
            <div class="flex gap-4 rounded-3xl bg-primary-900 text-white p-6 sm:p-8">
                <div class="w-12 h-12 shrink-0 rounded-2xl bg-white/10 flex items-center justify-center"><i data-lucide="eye" class="w-6 h-6 text-green-200"></i></div>
                <div><h3 class="text-lg font-black">وضوح قبل الوعود</h3><p class="text-sm text-white/70 leading-7 mt-2">الاستثمار في الإنتاج يرتبط بمخاطر تشغيل وسوق. تعرض دواب بيانات الدورة وسجلاتها لمساعدة المستخدم على الفهم، ولا تضمن عائداً أو نتيجة إنتاجية.</p></div>
            </div>
            <div class="flex gap-4 rounded-3xl bg-primary-50 border border-primary-100 p-6 sm:p-8">
                <div class="w-12 h-12 shrink-0 rounded-2xl bg-white flex items-center justify-center text-primary"><i data-lucide="shield-check" class="w-6 h-6"></i></div>
                <div><h3 class="text-lg font-black text-gray-900">إجراءات حماية بحسب الدورة</h3><p class="text-sm text-gray-600 leading-7 mt-2">تظهر تفاصيل العقود والتغطيات التأمينية، إن وجدت، ضمن معلومات الدورة ومستنداتها. راجع الشروط والاستثناءات قبل اتخاذ قرارك.</p></div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Cycles Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-10">
        <div>
            <div class="text-xs font-bold text-primary uppercase tracking-wider mb-1">فرص مميزة</div>
            <h2 class="text-3xl font-black text-gray-900">أحدث دورات التسمين المتاحة</h2>
        </div>
        <a asp-controller="Cycles" asp-action="Index" class="text-primary font-bold hover:underline flex items-center gap-1.5 text-sm">
            <span>عرض جميع الدورات</span>
            <i data-lucide="chevron-left" class="w-4 h-4"></i>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        @foreach (var cycle in Model.FeaturedCycles)
        {
            <div class="bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all border border-gray-100 flex flex-col group">
                <div class="relative h-52 overflow-hidden">
                    <img src="@cycle.ImageUrl" alt="@cycle.AnimalType" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    
                    <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-md px-2.5 py-1 rounded-full text-[11px] font-bold text-primary shadow">
                        متبقي: @cycle.RemainingFunding.ToString("N0") ج.م
                    </div>

                    @if (cycle.IsBarnInsured)
                    {
                        <div class="absolute top-3 right-3 bg-orange-600/95 text-white px-2.5 py-1 rounded-xl text-[10px] font-black shadow flex items-center gap-1">
                            <i data-lucide="shield" class="w-3 h-3"></i>
                            <span>خيار التأمين مسجل</span>
                        </div>
                    }
                </div>

                <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                    <div>
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="font-black text-gray-900 text-lg leading-tight">@cycle.AnimalType</h3>
                        </div>
                        <p class="text-xs text-gray-500 line-clamp-2 leading-relaxed">@cycle.Description</p>
                    </div>

                    <!-- Progress Bar -->
                    <div class="space-y-1.5">
                        <div class="flex justify-between text-xs font-bold">
                            <span class="text-gray-500">التمويل: @cycle.FundingProgressPercentage%</span>
                            <span class="text-primary">@cycle.FundingGoal.ToString("N0") ج.م</span>
                        </div>
                        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
                            <div class="bg-primary h-full rounded-full transition-all duration-500" style="width: @cycle.FundingProgressPercentage%"></div>
                        </div>
                    </div>

                    <div class="pt-3 border-t border-gray-100 flex items-center gap-2">
                        <a asp-controller="Cycles" asp-action="Details" asp-route-id="@cycle.Id" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold py-2.5 rounded-xl text-center text-xs transition-colors">
                            تفاصيل الدورة
                        </a>
                        @if (Context.Session.GetString("UserRole") == "Investor")
                        {
                            <button hx-get="/Investments/InvestModal?cycleId=@cycle.Id" 
                                    hx-target="#modal-container" 
                                    hx-swap="innerHTML"
                                    class="flex-1 bg-primary hover:bg-primary-700 text-white font-bold py-2.5 rounded-xl text-center text-xs transition-colors shadow-sm">
                                استثمر الآن
                            </button>
                        }
                        else if (Context.Session.GetString("UserId") == null)
                        {
                            <a asp-controller="Auth" asp-action="Login" class="flex-1 bg-primary hover:bg-primary-700 text-white font-bold py-2.5 rounded-xl text-center text-xs transition-colors shadow-sm">سجل الدخول للاستثمار</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.FeaturedCycles.Any())
    {
        <div class="text-center rounded-3xl border border-dashed border-gray-300 bg-gray-50 px-6 py-12">
            <div class="w-14 h-14 rounded-2xl bg-white text-gray-400 flex items-center justify-center mx-auto shadow-sm"><i data-lucide="calendar-days" class="w-7 h-7"></i></div>
            <h3 class="font-black text-gray-900 mt-4">لا توجد دورات متاحة حالياً</h3>
            <p class="text-sm text-gray-500 mt-2">نعمل على مراجعة الدورات الجديدة. يمكنك العودة لاحقاً أو التعرف على خطوات الانضمام.</p>
            <a asp-controller="Home" asp-action="Onboarding" class="inline-flex items-center gap-2 text-primary font-bold text-sm mt-4 hover:underline">تعرّف على طريقة البدء <i data-lucide="arrow-left" class="w-4 h-4"></i></a>
        </div>
    }
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14 sm:pb-20">
    <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-l from-primary-900 to-primary-700 px-6 py-10 sm:px-10 sm:py-12 text-center text-white">
        <div class="absolute -left-12 -top-20 w-56 h-56 rounded-full bg-white/5"></div>
        <div class="relative">
            <span class="text-xs font-bold text-green-200">خطوتك التالية</span>
            <h2 class="text-2xl sm:text-3xl font-black mt-2">لكل طرف طريق واضح للبدء</h2>
            <p class="text-sm text-white/70 mt-3">اختر حساب المستثمر لاستكشاف الدورات، أو حساب المربي لإدارة دورة إنتاج.</p>
            @if (Context.Session.GetString("UserId") == null)
            {
                <a asp-controller="Home" asp-action="Onboarding" class="inline-flex items-center justify-center gap-2 bg-white text-primary-900 font-black px-7 py-3.5 rounded-xl mt-6 hover:bg-green-50 transition-colors">اختيار نوع الحساب <i data-lucide="arrow-left" class="w-4 h-4"></i></a>
            }
        </div>
    </div>
</section>
