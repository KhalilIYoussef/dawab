@model Dawab.Application.DTOs.Dashboard.HomeDashboardDto
@{
    ViewData["Title"] = "دَوَابّ | المنصة الأولى للاستثمار في الثروة الحيوانية والإنتاج الحقيقي";
    var featuredCycle = Model.FeaturedCycles.FirstOrDefault();
}

<!-- Hero Section with Guaranteed Dark Green Background & Sharp Contrast -->
<section class="relative isolate overflow-hidden hero-gradient-bg text-white">
    <!-- Ambient Photo Watermark (Darkened and blended) -->
    <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
        <img src="https://images.unsplash.com/photo-1500595046743-cd271d694d30?auto=format&fit=crop&w=2000&q=80" 
             alt="مزارع الثروة الحيوانية" 
             class="w-full h-full object-cover opacity-20 mix-blend-luminosity filter brightness-75" />
        <div class="absolute inset-0 bg-[#041e08]/85"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#031706] via-transparent to-[#031706]/70"></div>
        <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-emerald-500/15 blur-3xl"></div>
        <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-amber-500/10 blur-3xl"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-24 sm:pt-24 sm:pb-32">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
            
            <!-- Hero Text Content -->
            <div class="lg:col-span-7 text-center lg:text-right space-y-6">
                <!-- Trust Pill Badge -->
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-emerald-200 text-xs sm:text-sm font-bold shadow-sm">
                    <span class="flex h-2.5 w-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>المنصة الأولى للاستثمار التشاركي الحيواني في مصر</span>
                    <span class="text-white/40">•</span>
                    <span class="text-amber-300 font-extrabold">متوافق 100% مع الشريعة</span>
                </div>

                <!-- Main Headline -->
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.2] text-white">
                    استثمر في <span class="text-amber-400">الإنتاج الحيواني</span> بعوائد حقيقية وضمانات موثقة
                </h1>

                <!-- Subtitle with high contrast -->
                <p class="text-base sm:text-lg text-emerald-100/90 leading-relaxed max-w-2xl mx-auto lg:mx-0 font-medium">
                    نربطك بأفضل مزارع التسمين المؤهلة بعقود إلكترونية رسمية، إشراف بيطري حكومي وخاص، وتأمين شامل مزدوج لحماية رأس مالك طوال دورة الإنتاج.
                </p>

                <!-- Action CTA Buttons -->
                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-2">
                    <a href="#calculator" 
                       class="inline-flex items-center justify-center gap-2.5 bg-amber-500 hover:bg-amber-600 text-gray-950 font-black px-8 py-4 rounded-2xl transition-all shadow-xl shadow-amber-500/25 hover:scale-[1.02]">
                        <i data-lucide="calculator" class="w-5 h-5 text-gray-950"></i>
                        <span>احسب أرباحك التقديرية</span>
                    </a>

                    <a asp-controller="Cycles" asp-action="Index" 
                       class="inline-flex items-center justify-center gap-2 bg-white/15 hover:bg-white/25 text-white font-bold px-8 py-4 rounded-2xl border-2 border-white/30 backdrop-blur transition-all">
                        <span>تصفح الدورات المتاحة</span>
                        <i data-lucide="arrow-left" class="w-5 h-5 text-white"></i>
                    </a>
                </div>

                <!-- Feature Highlights Under CTA -->
                <div class="grid grid-cols-3 gap-3 pt-6 border-t border-white/15 text-xs sm:text-sm text-white">
                    <div class="flex items-center gap-2 justify-center lg:justify-start">
                        <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-300 flex items-center justify-center shrink-0 border border-emerald-400/30">
                            <i data-lucide="file-check-2" class="w-4 h-4"></i>
                        </div>
                        <span class="font-bold">عقود رسمية ملزمة</span>
                    </div>

                    <div class="flex items-center gap-2 justify-center lg:justify-start">
                        <div class="w-8 h-8 rounded-lg bg-blue-500/20 text-blue-300 flex items-center justify-center shrink-0 border border-blue-400/30">
                            <i data-lucide="shield-check" class="w-4 h-4"></i>
                        </div>
                        <span class="font-bold">تأمين شامل 100%</span>
                    </div>

                    <div class="flex items-center gap-2 justify-center lg:justify-start">
                        <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-300 flex items-center justify-center shrink-0 border border-amber-400/30">
                            <i data-lucide="stethoscope" class="w-4 h-4"></i>
                        </div>
                        <span class="font-bold">رعاية بيطرية دورية</span>
                    </div>
                </div>
            </div>

            <!-- Right Hero Card / Live Opportunity Preview -->
            <div class="lg:col-span-5 max-w-md mx-auto w-full">
                <div class="relative bg-black/40 backdrop-blur-xl rounded-3xl p-5 border border-white/20 shadow-2xl space-y-4">
                    <!-- Header of preview card -->
                    <div class="flex justify-between items-center pb-3 border-b border-white/15">
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
                            <span class="text-xs font-bold text-white tracking-wide">فرصة تسمين مميزة الآن</span>
                        </div>
                        <span class="bg-amber-400 text-gray-950 text-[11px] font-black px-2.5 py-1 rounded-full shadow-sm">
                            عائد متوقع 22% - 28%
                        </span>
                    </div>

                    @if (featuredCycle != null)
                    {
                        <div class="space-y-4">
                            <!-- Image Container -->
                            <div class="relative h-56 rounded-2xl overflow-hidden group">
                                <img src="@(string.IsNullOrWhiteSpace(featuredCycle.ImageUrl) ? "https://images.unsplash.com/photo-1546445317-29f4545e9d53?auto=format&fit=crop&w=900&q=80" : featuredCycle.ImageUrl)" 
                                     alt="@featuredCycle.AnimalType" 
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-black/30"></div>
                                <div class="absolute top-3 right-3 bg-black/70 backdrop-blur-md text-white text-xs font-bold px-3 py-1 rounded-xl border border-white/20">
                                    دورة @featuredCycle.ExpectedDurationDays يوم
                                </div>
                                <div class="absolute bottom-3 right-3 left-3 text-white">
                                    <h3 class="text-xl font-black drop-shadow">@featuredCycle.AnimalType</h3>
                                    <p class="text-xs text-amber-300 font-bold mt-0.5">سعر الرأس: @featuredCycle.StartPricePerHead.ToString("N0") ج.م</p>
                                </div>
                            </div>

                            <!-- Metrics Grid inside card -->
                            <div class="grid grid-cols-2 gap-2 text-xs">
                                <div class="bg-white/10 border border-white/15 rounded-xl p-3">
                                    <span class="text-white/70 block text-[11px] font-medium">الوزن الحالي / المستهدف</span>
                                    <span class="text-white font-bold text-sm">@featuredCycle.InitialWeight.ToString("N0") كجم ← @featuredCycle.TargetWeight.ToString("N0") كجم</span>
                                </div>
                                <div class="bg-white/10 border border-white/15 rounded-xl p-3">
                                    <span class="text-white/70 block text-[11px] font-medium">المتبقي للتمويل</span>
                                    <span class="text-emerald-300 font-bold text-sm">@featuredCycle.RemainingFunding.ToString("N0") ج.م</span>
                                </div>
                            </div>

                            <!-- Progress Bar -->
                            <div class="space-y-1.5">
                                <div class="flex justify-between text-xs text-white font-bold">
                                    <span>اكتمال تمويل الدورة</span>
                                    <span class="text-amber-300 font-black">@featuredCycle.FundingProgressPercentage%</span>
                                </div>
                                <div class="w-full bg-white/20 h-2.5 rounded-full overflow-hidden p-0.5">
                                    <div class="bg-gradient-to-r from-amber-400 to-emerald-400 h-full rounded-full transition-all duration-700" 
                                         style="width: @featuredCycle.FundingProgressPercentage%"></div>
                                </div>
                            </div>

                            <!-- CTA in card -->
                            <div class="pt-2">
                                <a asp-controller="Cycles" asp-action="Details" asp-route-id="@featuredCycle.Id" 
                                   class="w-full py-3.5 bg-white hover:bg-emerald-50 text-gray-950 font-black rounded-xl text-center text-sm transition-all flex items-center justify-center gap-2 shadow-lg">
                                    <span>عرض التفاصيل والدراسة الكاملة</span>
                                    <i data-lucide="chevron-left" class="w-4 h-4 text-gray-950"></i>
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-8 text-center space-y-3">
                            <i data-lucide="sprout" class="w-12 h-12 text-emerald-400 mx-auto"></i>
                            <h4 class="font-bold text-white">دورات تسمين جديدة قيد الإعداد</h4>
                            <p class="text-xs text-white/70">يتم فحص مزارع جديدة وإعداد عقود التسمين وسنعلن عنها قريباً.</p>
                            <a asp-controller="Cycles" asp-action="Index" class="inline-block bg-white text-gray-950 font-bold px-4 py-2 rounded-xl text-xs">تصفح الأرشيف</a>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Live Stats Overview Bar -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-10 sm:-mt-12 relative z-20">
    <div class="bg-white rounded-3xl shadow-xl shadow-gray-200/50 border border-gray-100 p-6 sm:p-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 divide-y sm:divide-y-0 sm:divide-x sm:divide-x-reverse divide-gray-100">
            
            <div class="flex items-center gap-4 pt-4 sm:pt-0">
                <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-primary-700 flex items-center justify-center shrink-0 border border-emerald-100">
                    <i data-lucide="wallet" class="w-7 h-7"></i>
                </div>
                <div>
                    <span class="block text-xs font-bold text-gray-400 uppercase">حجم الاستثمارات الموجهة</span>
                    <span class="text-2xl sm:text-3xl font-black text-gray-900">@Model.TotalInvestedAmount.ToString("N0") <span class="text-xs font-bold text-gray-500">ج.م</span></span>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 sm:pt-0 sm:pr-6">
                <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-700 flex items-center justify-center shrink-0 border border-blue-100">
                    <i data-lucide="layers" class="w-7 h-7"></i>
                </div>
                <div>
                    <span class="block text-xs font-bold text-gray-400 uppercase">دورات التسمين الموثقة</span>
                    <span class="text-2xl sm:text-3xl font-black text-gray-900">@Model.TotalCyclesCount <span class="text-xs font-bold text-gray-500">دورة</span></span>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 sm:pt-0 sm:pr-6">
                <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-700 flex items-center justify-center shrink-0 border border-amber-100">
                    <i data-lucide="tractor" class="w-7 h-7"></i>
                </div>
                <div>
                    <span class="block text-xs font-bold text-gray-400 uppercase">المربون المعتمدون</span>
                    <span class="text-2xl sm:text-3xl font-black text-gray-900">@Model.ActiveBreederCount <span class="text-xs font-bold text-gray-500">مزرعة</span></span>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 sm:pt-0 sm:pr-6">
                <div class="w-14 h-14 rounded-2xl bg-purple-50 text-purple-700 flex items-center justify-center shrink-0 border border-purple-100">
                    <i data-lucide="shield-check" class="w-7 h-7"></i>
                </div>
                <div>
                    <span class="block text-xs font-bold text-gray-400 uppercase">احتياطي صندوق التأمين</span>
                    <span class="text-2xl sm:text-3xl font-black text-gray-900">@Model.InsuranceSummary.TotalFundBalance.ToString("N0") <span class="text-xs font-bold text-gray-500">ج.م</span></span>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Trust & Why Dawab Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-black text-primary-700 uppercase tracking-wider bg-emerald-50 px-4 py-1.5 rounded-full border border-emerald-200">
            لماذا يثق بنا المستثمرون والمربون؟
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-gray-900">
            أعلى معايير الأمان المالي والتشغيلي
        </h2>
        <p class="text-gray-600 text-sm sm:text-base leading-relaxed">
            الاستثمار في الإنتاج الحيواني مع منصة دواب ليس مجرد تمويل، بل منظومة متكاملة تضمن لك الشفافية من اليوم الأول وحتى لحظة تسوية الأرباح.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
        <!-- Feature 1 -->
        <div class="bg-white p-7 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-primary-700 flex items-center justify-center">
                <i data-lucide="scale" class="w-6 h-6"></i>
            </div>
            <h3 class="text-lg font-black text-gray-900">توافق شرعي تام</h3>
            <p class="text-xs text-gray-600 leading-relaxed">
                مضاربة ومشاركة حقيقية قائمة على الشراء والبيع الفعلي لرؤوس الماشية، بدون فوائد ربوية أو عوائد ثابتة محرمة.
            </p>
        </div>

        <!-- Feature 2 -->
        <div class="bg-white p-7 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <i data-lucide="shield-alert" class="w-6 h-6"></i>
            </div>
            <h3 class="text-lg font-black text-gray-900">تأمين شامل مزدوج</h3>
            <p class="text-xs text-gray-600 leading-relaxed">
                وثيقة تأمين حياة الماشية ضد النفوق والأوبئة بنسبة 3%، بالإضافة إلى تأمين الحظيرة المعتمد ضد الحوادث والحرائق.
            </p>
        </div>

        <!-- Feature 3 -->
        <div class="bg-white p-7 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center">
                <i data-lucide="video" class="w-6 h-6"></i>
            </div>
            <h3 class="text-lg font-black text-gray-900">متابعة لحظية مصورة</h3>
            <p class="text-xs text-gray-600 leading-relaxed">
                تقارير دورية تشمل أوزان الماشية، جداول الأعلاف، الفحوصات البيطرية، وتوثيق مصور بالفيديو لحالة مواشيك في المزرعة.
            </p>
        </div>

        <!-- Feature 4 -->
        <div class="bg-white p-7 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center">
                <i data-lucide="file-signature" class="w-6 h-6"></i>
            </div>
            <h3 class="text-lg font-black text-gray-900">عقود مدنية موثقة</h3>
            <p class="text-xs text-gray-600 leading-relaxed">
                عقد استثماري قانوني رسمي يحدد حقوق الطرفين بدقة، مع أرقام تعريفية لكل رأس ماشية مسجلة باسم المستثمر.
            </p>
        </div>
    </div>
</section>

<!-- Interactive Investment Calculator (Powered by Alpine.js) -->
<section id="calculator" class="bg-gradient-to-b from-gray-50 to-white py-20 border-y border-gray-100 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-2xl mx-auto space-y-3 mb-14">
            <span class="text-xs font-black text-amber-800 uppercase tracking-wider bg-amber-100 px-4 py-1.5 rounded-full border border-amber-300">
                حاسبة الأرباح التقديرية
            </span>
            <h2 class="text-3xl sm:text-4xl font-black text-gray-900">
                خطط لاستثمارك وتوقع أرباحك
            </h2>
            <p class="text-gray-600 text-sm leading-relaxed">
                حرك المؤشر لاختيار مبلغ الاستثمار واكتشف العائد الصافي المتوقع لدورة تسمين نموذجية مدتها 6 أشهر (180 يوماً).
            </p>
        </div>

        <div class="max-w-4xl mx-auto bg-white rounded-3xl shadow-xl shadow-gray-200/60 border border-gray-100 p-8 sm:p-12" 
             x-data="{ 
                amount: 60000,
                headPrice: 30000,
                roiRate: 0.24,
                get headsCount() { return Math.max(1, Math.floor(this.amount / this.headPrice)) },
                get expectedProfit() { return Math.round(this.amount * this.roiRate) },
                get totalPayout() { return this.amount + this.expectedProfit },
                setQuickAmount(val) { this.amount = val }
             }">

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                
                <!-- Controls Column -->
                <div class="lg:col-span-7 space-y-8">
                    <!-- Slider Block -->
                    <div class="space-y-4">
                        <div class="flex justify-between items-center">
                            <label class="text-sm font-bold text-gray-800">مبلغ الاستثمار المفضل:</label>
                            <span class="text-2xl font-black text-primary-800" x-text="Number(amount).toLocaleString('ar-EG') + ' ج.م'"></span>
                        </div>

                        <input type="range" 
                               min="10000" 
                               max="300000" 
                               step="5000" 
                               x-model.number="amount"
                               class="w-full h-3 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-primary-700 focus:outline-none" />

                        <div class="flex justify-between text-[11px] text-gray-500 font-bold">
                            <span>10,000 ج.م</span>
                            <span>150,000 ج.م</span>
                            <span>300,000 ج.م</span>
                        </div>
                    </div>

                    <!-- Quick Pre-set Buttons -->
                    <div class="space-y-2">
                        <span class="text-xs font-bold text-gray-600 block">اختيار سريع للمبالغ الشائعة:</span>
                        <div class="flex flex-wrap gap-2">
                            <button @@click="setQuickAmount(30000)" 
                                    :class="amount === 30000 ? 'bg-primary text-white' : 'bg-gray-100 text-gray-800 hover:bg-gray-200'"
                                    class="px-4 py-2 rounded-xl text-xs font-bold transition-colors">
                                30,000 ج.م (1 رأس)
                            </button>
                            <button @@click="setQuickAmount(60000)" 
                                    :class="amount === 60000 ? 'bg-primary text-white' : 'bg-gray-100 text-gray-800 hover:bg-gray-200'"
                                    class="px-4 py-2 rounded-xl text-xs font-bold transition-colors">
                                60,000 ج.م (2 رأس)
                            </button>
                            <button @@click="setQuickAmount(150000)" 
                                    :class="amount === 150000 ? 'bg-primary text-white' : 'bg-gray-100 text-gray-800 hover:bg-gray-200'"
                                    class="px-4 py-2 rounded-xl text-xs font-bold transition-colors">
                                150,000 ج.م (5 رؤوس)
                            </button>
                            <button @@click="setQuickAmount(300000)" 
                                    :class="amount === 300000 ? 'bg-primary text-white' : 'bg-gray-100 text-gray-800 hover:bg-gray-200'"
                                    class="px-4 py-2 rounded-xl text-xs font-bold transition-colors">
                                300,000 ج.م (10 رؤوس)
                            </button>
                        </div>
                    </div>

                    <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-xs text-amber-900 flex items-start gap-3">
                        <i data-lucide="info" class="w-5 h-5 text-amber-700 shrink-0 mt-0.5"></i>
                        <p class="leading-relaxed">
                            هذه الحاسبة تقديرية مبنية على متوسط أداء دورات التسمين السابقة (متوسط 24% في 6 أشهر بعد خصم عمولة المنصة وحصة المربي). تخضع النتيجة النهائية لأسعار بيع السوق الحي عند إغلاق الدورة.
                        </p>
                    </div>
                </div>

                <!-- Result Card Column with Guaranteed Dark Green Gradient -->
                <div class="lg:col-span-5 cta-gradient-bg text-white p-7 rounded-3xl shadow-xl space-y-6 border border-emerald-900">
                    <div class="flex justify-between items-center border-b border-white/15 pb-4">
                        <span class="text-xs font-bold text-emerald-200">العائد الصافي المتوقع</span>
                        <span class="bg-amber-400 text-gray-950 font-black text-xs px-2.5 py-1 rounded-full shadow-sm">
                            متوسط 24% / 6 أشهر
                        </span>
                    </div>

                    <div class="space-y-4 text-sm">
                        <div class="flex justify-between items-center text-white/90">
                            <span>عدد الرؤوس التقديري:</span>
                            <span class="font-black text-white text-base" x-text="headsCount + ' رأس ماشية'"></span>
                        </div>

                        <div class="flex justify-between items-center text-white/90">
                            <span>فترة دورة التسمين:</span>
                            <span class="font-bold text-white">6 أشهر (180 يوماً)</span>
                        </div>

                        <div class="flex justify-between items-center text-emerald-300">
                            <span class="font-bold">صافي الأرباح المتوقعة:</span>
                            <span class="font-black text-lg" x-text="Number(expectedProfit).toLocaleString('ar-EG') + ' ج.م'"></span>
                        </div>

                        <div class="pt-4 border-t border-white/15 flex justify-between items-center">
                            <div>
                                <span class="block text-xs text-emerald-100/70">إجمالي المسترد (رأس المال + الربح)</span>
                                <span class="text-2xl font-black text-amber-300" x-text="Number(totalPayout).toLocaleString('ar-EG') + ' ج.م'"></span>
                            </div>
                        </div>
                    </div>

                    <a asp-controller="Cycles" asp-action="Index" 
                       class="w-full py-4 bg-amber-500 hover:bg-amber-600 text-gray-950 font-black rounded-xl text-center text-sm transition-all flex items-center justify-center gap-2 shadow-lg hover:scale-[1.02]">
                        <span>استثمر الآن في الدورات النشطة</span>
                        <i data-lucide="arrow-left" class="w-4 h-4 text-gray-950"></i>
                    </a>
                </div>

            </div>

        </div>

    </div>
</section>

<!-- How Dawab Works (Step by Step) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center max-w-2xl mx-auto space-y-3 mb-16">
        <span class="text-xs font-black text-primary-700 uppercase tracking-wider bg-emerald-50 px-4 py-1.5 rounded-full border border-emerald-200">
            خطوات بسيطة ومضمونة
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-gray-900">
            كيف تبدأ استثمارك في 4 خطوات؟
        </h2>
        <p class="text-gray-600 text-sm leading-relaxed">
            منصة رقمية سلسة تتيح لك إدارة ومتابعة استثمارك في الثروة الحيوانية من هاتفك في أي مكان.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 relative">
        
        <!-- Step 1 -->
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm relative group hover:-translate-y-1 transition-all">
            <span class="w-10 h-10 rounded-2xl bg-primary text-white font-black text-sm flex items-center justify-center mb-5 shadow-md shadow-primary/20">
                1
            </span>
            <h3 class="font-black text-gray-900 text-lg mb-2">اختر الدورة المناسبة</h3>
            <p class="text-xs text-gray-600 leading-relaxed">
                تصفح دورات التسمين النشطة، راجع نوع الماشية، فترة التسمين، وموقع المزرعة وخبرة المربي المعتمد.
            </p>
        </div>

        <!-- Step 2 -->
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm relative group hover:-translate-y-1 transition-all">
            <span class="w-10 h-10 rounded-2xl bg-primary text-white font-black text-sm flex items-center justify-center mb-5 shadow-md shadow-primary/20">
                2
            </span>
            <h3 class="font-black text-gray-900 text-lg mb-2">وثق العقد وحول المبلغ</h3>
            <p class="text-xs text-gray-600 leading-relaxed">
                حدد عدد الرؤوس أو المبلغ، ارفع إيصال التحويل البنكي أو إنستاباي، ويتم إصدار عقدك الاستثماري الموثق فوراً.
            </p>
        </div>

        <!-- Step 3 -->
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm relative group hover:-translate-y-1 transition-all">
            <span class="w-10 h-10 rounded-2xl bg-primary text-white font-black text-sm flex items-center justify-center mb-5 shadow-md shadow-primary/20">
                3
            </span>
            <h3 class="font-black text-gray-900 text-lg mb-2">تابع النمو بالفيديو</h3>
            <p class="text-xs text-gray-600 leading-relaxed">
                استلم سجلات دورية مصورة عن زيادة الأوزان، جرعات التطعيم، وجودة الأعلاف المستهلكة من داخل الحظيرة.
            </p>
        </div>

        <!-- Step 4 -->
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm relative group hover:-translate-y-1 transition-all">
            <span class="w-10 h-10 rounded-2xl bg-amber-500 text-gray-950 font-black text-sm flex items-center justify-center mb-5 shadow-md shadow-amber-500/20">
                4
            </span>
            <h3 class="font-black text-gray-900 text-lg mb-2">استلم رأس المال والأرباح</h3>
            <p class="text-xs text-gray-600 leading-relaxed">
                عند انتهاء الدورة وبيع الماشية في المزاد أو للأسواق الكبرى، تُحول أرباحك ورأس مالك مباشرة لحسابك البنكي.
            </p>
        </div>

    </div>
</section>

<!-- Active Featured Cycles Grid -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 border-t border-gray-100">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-12">
        <div>
            <span class="text-xs font-black text-primary-700 uppercase tracking-wider bg-emerald-50 px-4 py-1.5 rounded-full border border-emerald-200">
                فرص متاحة الآن
            </span>
            <h2 class="text-3xl sm:text-4xl font-black text-gray-900 mt-3">دورات تسمين نشطة للاستثمار</h2>
        </div>
        <a asp-controller="Cycles" asp-action="Index" class="inline-flex items-center gap-2 text-primary font-bold hover:text-primary-700 transition-colors text-sm">
            <span>تصفح جميع الفرص المتاحة</span>
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        @foreach (var cycle in Model.FeaturedCycles)
        {
            <div class="bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all border border-gray-100 flex flex-col group">
                <!-- Cycle Image & Badges -->
                <div class="relative h-56 overflow-hidden">
                    <img src="@cycle.ImageUrl" alt="@cycle.AnimalType" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                    
                    <div class="absolute top-3 left-3 bg-white/95 backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold text-gray-900 shadow">
                        متبقي: @cycle.RemainingFunding.ToString("N0") ج.م
                    </div>

                    @if (cycle.IsBarnInsured)
                    {
                        <div class="absolute top-3 right-3 bg-emerald-700 text-white px-2.5 py-1 rounded-xl text-[10px] font-black shadow flex items-center gap-1">
                            <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                            <span>تأمين حظيرة معتمد</span>
                        </div>
                    }

                    <div class="absolute bottom-3 right-3 left-3 text-white">
                        <span class="text-[11px] font-bold text-emerald-300">دورة تسمين لمدة @cycle.ExpectedDurationDays يوماً</span>
                        <h3 class="font-black text-xl text-white">@cycle.AnimalType</h3>
                    </div>
                </div>

                <!-- Cycle Body -->
                <div class="p-6 flex-1 flex flex-col justify-between space-y-5">
                    <p class="text-xs text-gray-600 line-clamp-2 leading-relaxed">@cycle.Description</p>

                    <!-- Key stats pill grid -->
                    <div class="grid grid-cols-2 gap-2 text-xs bg-gray-50 p-3 rounded-2xl border border-gray-100">
                        <div>
                            <span class="text-gray-500 block text-[10px] font-medium">سعر الرأس:</span>
                            <span class="font-black text-gray-900 text-sm">@cycle.StartPricePerHead.ToString("N0") ج.م</span>
                        </div>
                        <div>
                            <span class="text-gray-500 block text-[10px] font-medium">الوزن المتوقع:</span>
                            <span class="font-black text-gray-900 text-sm">@cycle.TargetWeight.ToString("N0") كجم</span>
                        </div>
                    </div>

                    <!-- Funding Progress -->
                    <div class="space-y-1.5">
                        <div class="flex justify-between text-xs font-bold">
                            <span class="text-gray-600">اكتمال التمويل: @cycle.FundingProgressPercentage%</span>
                            <span class="text-primary font-black">@cycle.FundingGoal.ToString("N0") ج.م</span>
                        </div>
                        <div class="w-full bg-gray-100 h-2.5 rounded-full overflow-hidden">
                            <div class="bg-primary h-full rounded-full transition-all duration-500" style="width: @cycle.FundingProgressPercentage%"></div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="pt-2 flex items-center gap-2">
                        <a asp-controller="Cycles" asp-action="Details" asp-route-id="@cycle.Id" 
                           class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-900 font-bold py-3 rounded-xl text-center text-xs transition-colors">
                            تفاصيل ودراسة الدورة
                        </a>

                        @if (Context.Session.GetString("UserRole") == "Investor")
                        {
                            <button hx-get="/Investments/InvestModal?cycleId=@cycle.Id" 
                                    hx-target="#modal-container" 
                                    hx-swap="innerHTML"
                                    class="flex-1 bg-primary hover:bg-primary-700 text-white font-bold py-3 rounded-xl text-center text-xs transition-colors shadow-sm">
                                استثمر الآن
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" 
                               class="flex-1 bg-primary hover:bg-primary-700 text-white font-bold py-3 rounded-xl text-center text-xs transition-colors shadow-sm">
                                ابدأ الاستثمار
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.FeaturedCycles.Any())
    {
        <div class="text-center py-16 bg-white rounded-3xl border border-dashed border-gray-200">
            <i data-lucide="calendar" class="w-12 h-12 text-gray-300 mx-auto mb-3"></i>
            <h3 class="font-bold text-gray-700">لا توجد دورات متاحة للعرض حالياً</h3>
            <p class="text-xs text-gray-500 mt-1">يتم مراجعة دورات جديدة من قبل فريق الإشراف البيطري وسيتم طرحها قريباً.</p>
        </div>
    }
</section>

