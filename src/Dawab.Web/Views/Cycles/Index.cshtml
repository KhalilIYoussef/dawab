@model Dawab.Web.ViewModels.CyclesListViewModel
@{
    ViewData["Title"] = "فرص الاستثمار المتاحة";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header with Search -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-black text-gray-900">فرص الاستثمار المتاحة</h1>
            <p class="text-sm text-gray-500 mt-1">راجع بيانات كل دورة وخيارات التغطية والمستندات المرفقة قبل اتخاذ قرارك</p>
        </div>

        <!-- Search Bar with Form -->
        <form method="get" asp-action="Index" class="w-full md:w-96 flex gap-2">
            <div class="relative flex-1">
                <i data-lucide="search" class="w-4 h-4 text-gray-400 absolute right-3.5 top-3.5"></i>
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="ابحث بنوع الحيوان أو المربي..." class="w-full pr-10 pl-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary">
            </div>
            <button type="submit" class="bg-primary hover:bg-primary-700 text-white font-bold px-4 py-2.5 rounded-xl text-sm transition-colors">
                بحث
            </button>
        </form>
    </div>

    <!-- Cycles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var cycle in Model.Cycles)
        {
            <div class="bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all border border-gray-100 flex flex-col group">
                <div class="relative h-48 overflow-hidden">
                    <img src="@cycle.ImageUrl" alt="@cycle.AnimalType" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    
                    <div class="absolute top-3 left-3 bg-white/95 backdrop-blur-md px-2.5 py-1 rounded-full text-[11px] font-bold text-primary shadow">
                        متبقي: @cycle.RemainingFunding.ToString("N0") ج.م
                    </div>

                    @if (cycle.IsBarnInsured)
                    {
                        <div class="absolute top-3 right-3 bg-orange-600/95 text-white px-2.5 py-1 rounded-xl text-[10px] font-black shadow flex items-center gap-1">
                            <i data-lucide="shield" class="w-3 h-3"></i>
                            <span>خيار التأمين مسجل</span>
                        </div>
                    }
                </div>

                <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                    <div>
                        <div class="flex justify-between items-start mb-1">
                            <h3 class="font-black text-gray-900 text-lg leading-tight">@cycle.AnimalType</h3>
                            <span class="text-xs font-bold text-gray-500">@cycle.TotalHeads رأس</span>
                        </div>
                        <p class="text-xs text-gray-400">المربي: <span class="text-gray-700 font-bold">@cycle.BreederName</span> (@cycle.BreederGovernorate)</p>
                        <p class="text-xs text-gray-500 line-clamp-2 mt-2 leading-relaxed">@cycle.Description</p>
                    </div>

                    <!-- Progress Bar -->
                    <div class="space-y-1.5">
                        <div class="flex justify-between text-xs font-bold">
                            <span class="text-gray-500">التمويل: @cycle.FundingProgressPercentage%</span>
                            <span class="text-primary">@cycle.FundingGoal.ToString("N0") ج.م</span>
                        </div>
                        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
                            <div class="bg-primary h-full rounded-full transition-all duration-500" style="width: @cycle.FundingProgressPercentage%"></div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="pt-3 border-t border-gray-100 flex items-center gap-2">
                        <a asp-action="Details" asp-route-id="@cycle.Id" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold py-2.5 rounded-xl text-center text-xs transition-colors">
                            تفاصيل وخطة التسمين
                        </a>

                        @if (cycle.Status == CycleStatus.Funding && cycle.RemainingFunding > 0)
                        {
                            @if (Context.Session.GetString("UserRole") == "Investor")
                            {
                                <button hx-get="/Investments/InvestModal?cycleId=@cycle.Id" 
                                        hx-target="#modal-container" 
                                        hx-swap="innerHTML"
                                        class="flex-1 bg-primary hover:bg-primary-700 text-white font-bold py-2.5 rounded-xl text-center text-xs transition-colors shadow-sm">
                                    استثمر الآن
                                </button>
                            }
                            else if (Context.Session.GetString("UserId") == null)
                            {
                                <a asp-controller="Auth" asp-action="Login" class="flex-1 bg-primary hover:bg-primary-700 text-white font-bold py-2.5 rounded-xl text-center text-xs transition-colors shadow-sm">سجل الدخول للاستثمار</a>
                            }
                        }
                        else
                        {
                            <span class="flex-1 bg-gray-100 text-gray-500 font-bold py-2.5 rounded-xl text-center text-xs border border-gray-200">
                                اكتمل التمويل
                            </span>
                        }
                    </div>

                    <!-- AI Risk Analysis Trigger -->
                    <button hx-get="/Cycles/RiskAnalysis?id=@cycle.Id" 
                            hx-target="#modal-container" 
                            hx-swap="innerHTML"
                            class="w-full py-1.5 text-[11px] font-bold text-gray-500 hover:text-primary flex items-center justify-center gap-1 transition-colors">
                        <i data-lucide="bot" class="w-3.5 h-3.5 text-primary"></i>
                        <span>عرض تقييم المخاطر الذكي (Gemini AI)</span>
                    </button>
                </div>
            </div>
        }
    </div>

    @if (!Model.Cycles.Any())
    {
        <div class="text-center py-20 bg-white rounded-3xl border border-dashed border-gray-200 mt-8">
            <i data-lucide="search-x" class="w-12 h-12 text-gray-300 mx-auto mb-3"></i>
            <h3 class="font-bold text-gray-700 text-lg">لا توجد دورات مفتوحة للتمويل حالياً</h3>
            <p class="text-xs text-gray-400 mt-1">@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "عد لاحقاً للاطلاع على الدورات المتاحة بعد اعتمادها." : "جرب البحث بكلمات أخرى أو امسح البحث لعرض الدورات المتاحة.")</p>
        </div>
    }
</div>
