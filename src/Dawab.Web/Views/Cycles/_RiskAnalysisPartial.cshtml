@model Dawab.Application.DTOs.Ai.AiRiskReportDto

<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in" x-data="{ open: true }" x-show="open">
    <div class="bg-white rounded-3xl w-full max-w-2xl shadow-2xl max-h-[90vh] overflow-y-auto border border-gray-100 flex flex-col">
        <!-- Modal Header -->
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50/50 sticky top-0 z-10">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-primary-50 text-primary flex items-center justify-center font-bold">
                    <i data-lucide="bot" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-lg font-black text-gray-900">تقرير التحليل الذكي للمخاطر</h3>
                    <p class="text-[11px] text-gray-400">تحليل فني وبيطري مدعوم بـ Google Gemini AI</p>
                </div>
            </div>
            <button @@click="open = false; document.getElementById('modal-container').innerHTML = ''" class="w-9 h-9 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-500 flex items-center justify-center transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6 space-y-6">
            <div class="flex items-center justify-between p-4 bg-green-50/70 border border-green-100 rounded-2xl text-xs">
                <div class="flex items-center gap-2 text-green-900 font-bold">
                    <i data-lucide="shield-check" class="w-4 h-4 text-green-700"></i>
                    <span>دورة @Model.AnimalType</span>
                </div>
                <span class="bg-white px-2.5 py-1 rounded-lg text-primary font-black border border-green-200 shadow-sm">
                    مؤشر الأمان: ممتاز (@(Model.RiskScore ?? 2.5m)/10)
                </span>
            </div>

            <div class="space-y-4 text-sm text-gray-700 leading-relaxed whitespace-pre-line bg-gray-50 p-5 rounded-2xl border border-gray-100">
                @Model.AnalysisReport
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="p-4 bg-gray-50 border-t border-gray-100 flex justify-end">
            <button @@click="open = false; document.getElementById('modal-container').innerHTML = ''" class="bg-gray-800 hover:bg-black text-white text-xs font-bold px-6 py-2.5 rounded-xl transition-colors">
                إغلاق التقرير
            </button>
        </div>
    </div>
</div>

<script>
    lucide.createIcons();
</script>
